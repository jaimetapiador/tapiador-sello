rules_version = '2';

// El navegador no accede nunca a Firestore: todo pasa por las Cloud Functions (Admin SDK),
// que no están sujetas a estas reglas. Cualquier lectura o escritura directa se deniega.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
