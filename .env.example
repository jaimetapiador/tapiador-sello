# Copiar a .env.local y rellenar. .env.local no se sube nunca al repositorio.

# Cuenta de la demo (solo fondos de prueba de Base Sepolia).
SELLO_ADDRESS=
SELLO_PRIVATE_KEY=

# RPC de Base Sepolia. El público tiene límite de peticiones, pero basta para el H1.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Contrato SelloRegistry desplegado en Base Sepolia (público).
SELLO_REGISTRY_ADDRESS=0xCeCc456e339047bbA466536DFF9247449D12A3D1
